# Safe default for the full-stack demo. Set to false only after configuring a key.
CANDIDATE_FAKE_MODEL=true

# Candidate model configuration.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
MODEL_TIMEOUT_SECONDS=120
LLM_INPUT_PRICE_CNY_PER_MILLION=2
LLM_OUTPUT_PRICE_CNY_PER_MILLION=8
LLM_CACHED_PRICE_CNY_PER_MILLION=0.5
LLM_TOOL_COST_CNY=0
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional semantic Judge. It remains unavailable until the selected provider has a key.
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=deepseek-chat
JUDGE_TIMEOUT_SECONDS=60
JUDGE_MAX_CONTEXT_BYTES=131072

# Tool-grant audit retention.
TOOL_GRANT_RETENTION_SECONDS=604800
TOOL_GRANT_CLEANUP_BATCH_SIZE=1000

